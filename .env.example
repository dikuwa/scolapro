# Public Supabase values safe for browser use
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase/admin values
SUPABASE_SERVICE_ROLE_KEY=
INTERNAL_JOB_RUNNER_SECRET=
CRON_SECRET=

# Communication transport worker (server-only)
COMMUNICATION_RECEIPT_INGEST_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Test/local-only adapter; never enable in production.
COMMUNICATION_MOCK_TRANSPORT_ENABLED=false

# Optional infrastructure providers
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
POSTHOG_KEY=
POSTHOG_HOST=
SENTRY_DSN=
TRIGGER_SECRET_KEY=

# Safety switches
COMMUNICATIONS_ENABLED=false
ANALYTICS_ENABLED=false
SESSION_REPLAY_ENABLED=false
