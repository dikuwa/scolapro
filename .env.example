# Public Supabase values safe for browser use
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase/admin values
SUPABASE_SERVICE_ROLE_KEY=
INTERNAL_JOB_RUNNER_SECRET=
CRON_SECRET=

# Communication transport worker (server-only)
COMMUNICATION_RECEIPT_INGEST_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=

# Bird SMS transport + signed webhook (server-only)
# Use the workspace regional platform host, e.g. https://eu1.platform.bird.com
BIRD_API_BASE_URL=
BIRD_API_KEY=
BIRD_SMS_FROM=
BIRD_SMS_CATEGORY=transactional
BIRD_WEBHOOK_SECRET=

# Test/local-only adapter; never enable in production.
COMMUNICATION_MOCK_TRANSPORT_ENABLED=false

# Optional infrastructure providers
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
POSTHOG_KEY=
POSTHOG_HOST=
SENTRY_DSN=
TRIGGER_SECRET_KEY=

# Safety switches
COMMUNICATIONS_ENABLED=false
ANALYTICS_ENABLED=false
SESSION_REPLAY_ENABLED=false
